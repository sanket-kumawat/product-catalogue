# API (validated on startup). Copy to .env for local `pnpm dev`.
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
FAKE_STORE_BASE_URL=https://fakestoreapi.com
PRODUCT_CACHE_TTL_MS=300000
FEATURED_PRODUCT_IDS=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@product-catalogue.local
SALES_INBOX_EMAIL=sales@product-catalogue.local
ENQUIRY_RATE_LIMIT_WINDOW_MS=60000
ENQUIRY_RATE_LIMIT_MAX=10

# Web, build-time only. Unset means requests go to /api (Vite proxy or nginx).
# An absolute URL must match CORS_ORIGIN.
# VITE_API_URL=/api
