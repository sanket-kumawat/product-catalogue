{
  "name": "@product-catalogue/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @product-catalogue/shared build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @product-catalogue/shared build",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "pretest": "pnpm --filter @product-catalogue/shared build",
    "test": "vitest run",
    "dev": "node --watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@product-catalogue/shared": "workspace:*",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "nodemailer": "^10.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
